<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MesaCerta.Desktop.ViewModels"
             x:Class="MesaCerta.Desktop.Views.PayDialogView"
             x:DataType="vm:PayDialogViewModel">
  <StackPanel Spacing="16">
    <Border Classes="confirm">
      <StackPanel Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="{Binding SummaryText}" Classes="muted" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ItemsText}" Classes="muted" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
    <TextBlock Classes="label" Text="Forma de pagamento" />
    <UniformGrid Columns="2">
      <RadioButton GroupName="method" IsChecked="{Binding IsPix}" Margin="0,0,6,0" AutomationProperties.Name="Pix">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{x:Static vm:Icons.Wallet}" Stroke="#45546A" Width="22" Height="22" />
          <TextBlock Text="Pix" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </RadioButton>
      <RadioButton GroupName="method" IsChecked="{Binding IsCard}" Margin="6,0,0,0" AutomationProperties.Name="Cartão">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{x:Static vm:Icons.Card}" Stroke="#45546A" Width="22" Height="22" />
          <TextBlock Text="Cartão" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </RadioButton>
    </UniformGrid>
  </StackPanel>
</UserControl>
