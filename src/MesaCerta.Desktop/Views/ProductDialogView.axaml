<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MesaCerta.Desktop.ViewModels"
             x:Class="MesaCerta.Desktop.Views.ProductDialogView"
             x:DataType="vm:ProductDialogViewModel">
  <StackPanel Spacing="14">
    <StackPanel>
      <TextBlock Classes="label" Text="Nome" />
      <TextBox Text="{Binding Name}" MaxLength="100" AutomationProperties.Name="Nome" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" Text="Tipo" />
      <ComboBox ItemsSource="{Binding SaleTypes}" SelectedIndex="{Binding SaleTypeIndex}" AutomationProperties.Name="Tipo" />
    </StackPanel>
    <StackPanel>
      <TextBlock Classes="label" Text="{Binding PriceLabel}" />
      <TextBox Text="{Binding Price}" Watermark="Ex.: 65,90" AutomationProperties.Name="Preço" />
    </StackPanel>
    <CheckBox IsChecked="{Binding Active}" Content="Disponível para pedidos" />
  </StackPanel>
</UserControl>
